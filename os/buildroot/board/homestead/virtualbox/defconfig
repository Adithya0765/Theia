# Homestead virtualbox defconfig — stage 0.
# Minimal x86-64, BIOS+EFI hybrid ISO, graphics+net for VBox.
# Kernel itself is upstream LTS; this fragment only ENSURES the driver
# set VirtualBox needs. No kernel fork, no out-of-tree patches in v0.
BR2_x86_64=y
BR2_x86_corei7=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_KERNEL_HEADERS_6_6=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# Kernel: upstream LTS, in-tree VBox/VirtIO drivers as modules
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.6.72"
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="x86_64"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_HOMESTEAD_PATH)/board/homestead/virtualbox/kernel.config.fragment"
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

# Firmware + Mesa userspace so the drivers actually light up
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_DRI_DRIVER_SWRAST=y
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_LIBINPUT=y
BR2_PACKAGE_WAYLAND=y

# Device management without systemd
BR2_PACKAGE_EUDEV=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y

# ISO: hybrid BIOS+EFI, squashfs root, initramfs
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_ISO9660=y
BR2_TARGET_ROOTFS_ISO9660_BOOT_MENU="board/homestead/virtualbox/grub.cfg"
BR2_TARGET_ROOTFS_ISO9660_HYBRID=y
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_BUILTIN_MODULES="biosdisk iso9660 linux normal"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_HOMESTEAD_PATH)/../../overlay"

# Debug + bring-up tools (stage 0 only, trimmed later)
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_PCIUTILS=y
BR2_PACKAGE_USBMODEM=y
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_VIM=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_VIRTUALBOX_GUEST_DRV=y
BR2_PACKAGE_VIRTUALBOX_GUEST_X11=y
BR2_PACKAGE_HOMESTEAD_SESSION=y
