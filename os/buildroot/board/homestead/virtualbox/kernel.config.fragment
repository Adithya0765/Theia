# Keep the kernel boring: upstream x86_64 defconfig + VirtualBox/VirtIO essentials.
CONFIG_VBOXGUEST=m
CONFIG_DRM_VBOXVIDEO=m
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_INPUT_EVDEV=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_ISO9660_FS=y
CONFIG_EFIVAR_FS=y
